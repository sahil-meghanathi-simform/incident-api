generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REPORTER
  TRIAGE_MANAGER
  INVESTIGATOR
  ADMIN
}

// Declaration order is load-bearing: `sort=severity` relies on Postgres enum
// declaration order matching SEVERITY_RANK. Do not reorder without updating
// src/config/constants.ts and policy/clearance.policy.ts together.
enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Stage {
  REPORTED
  TRIAGE
  INVESTIGATION
  PENDING_CLOSURE
  CLOSED
}

enum IncidentType {
  SAFETY
  SECURITY
  ENVIRONMENTAL
  OPERATIONAL
  DATA_PRIVACY
  EQUIPMENT
  OTHER
}

enum AuditEventType {
  INCIDENT_CREATED
  STAGE_CHANGED
  SEVERITY_CHANGED
  INVESTIGATOR_ASSIGNED
  INVESTIGATOR_UNASSIGNED
  INCIDENT_ACKNOWLEDGED
  NOTE_ADDED
  CLOSURE_PROPOSED
  CLOSURE_APPROVED
  CLOSURE_REJECTED
  INCIDENT_ESCALATED
  ACCESS_DENIED
  USER_CLEARANCE_CHANGED
  USER_ROLE_CHANGED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  displayName    String
  role           Role     @default(REPORTER)
  clearanceLevel Int      @default(1) // CHECK 1..4 via raw migration (clearance_range)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reportedIncidents     Incident[]          @relation("reporter")
  assignedIncidents     Incident[]          @relation("assignee")
  acknowledgedIncidents Incident[]          @relation("acknowledger")
  closedIncidents       Incident[]          @relation("closer")
  proposedClosures      Incident[]          @relation("closureProposer")
  notes                 InvestigationNote[]
  auditEvents           AuditEvent[]
  refreshTokens         RefreshToken[]
  notifications         NotificationLog[]

  @@index([role, clearanceLevel])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  sessionId    String // = the access JWT's `sid` claim; stable across rotation, the reuse-detection family key
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([sessionId])
}

model Incident {
  id          String       @id @default(cuid())
  reference   String       @unique // INC-2026-000123, allocated from incident_reference_seq
  type        IncidentType
  severity    Severity
  stage       Stage        @default(REPORTED)
  title       String
  description String

  reporterId             String
  assignedInvestigatorId String?
  acknowledgedById       String?
  acknowledgedAt         DateTime?

  highSeveritySince      DateTime? // Q19 — escalation clock origin. Non-null iff severity is HIGH/CRITICAL.
  escalationCycle        Int       @default(0) // bumped whenever the clock (re)starts
  currentEscalationLevel Int       @default(0) // denormalised pre-filter, NOT the correctness mechanism
  lastEscalatedAt        DateTime?

  rootCause           String?
  correctiveAction    String?
  closureProposedById String?
  closureProposedAt   DateTime?
  closedById          String?
  closedAt            DateTime?

  version   Int      @default(0) // optimistic lock (§2.8) — guards user-intent fields only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter        User  @relation("reporter", fields: [reporterId], references: [id])
  assignee        User? @relation("assignee", fields: [assignedInvestigatorId], references: [id])
  acknowledger    User? @relation("acknowledger", fields: [acknowledgedById], references: [id])
  closer          User? @relation("closer", fields: [closedById], references: [id])
  closureProposer User? @relation("closureProposer", fields: [closureProposedById], references: [id])

  notes            InvestigationNote[]
  auditEvents      AuditEvent[]
  escalationEvents EscalationEvent[]

  @@index([severity, stage, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)]) // default list cursor
  @@index([assignedInvestigatorId, stage])
  @@index([type, severity, createdAt]) // analytics group-by
  @@index([reporterId, createdAt(sort: Desc)])
}

model InvestigationNote {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String
  body       String
  createdAt  DateTime @default(now()) // immutable: no updatedAt by design (Q24b)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([incidentId, createdAt(sort: Desc)])
}

model AuditEvent {
  id         String         @id @default(cuid())
  incidentId String?
  actorId    String?
  type       AuditEventType
  fromValue  String?
  toValue    String?
  reason     String?
  payload    Json?
  occurredAt DateTime       @default(now())

  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?     @relation(fields: [actorId], references: [id])

  @@index([incidentId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([type, occurredAt])
  @@index([actorId, occurredAt])
}

model EscalationTier {
  id               String   @id @default(cuid())
  severity         Severity
  level            Int
  thresholdMinutes Int
  isActive         Boolean  @default(true)
  updatedById      String?
  updatedAt        DateTime @updatedAt

  @@unique([severity, level])
}

model EscalationEvent {
  id                   String   @id @default(cuid())
  incidentId           String
  cycle                Int
  level                Int
  severityAtEscalation Severity
  dueAt                DateTime
  triggeredAt          DateTime @default(now()) // job always supplies this explicitly (injected Clock)

  incident      Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  notifications NotificationLog[]

  @@unique([incidentId, cycle, level]) // the idempotency guarantee (Q21)
  @@index([triggeredAt(sort: Desc)])
}

model NotificationLog {
  id                String    @id @default(cuid())
  escalationEventId String
  recipientId       String
  channel           String    @default("IN_APP")
  readAt            DateTime?
  createdAt         DateTime  @default(now()) // job always supplies this explicitly

  escalationEvent EscalationEvent @relation(fields: [escalationEventId], references: [id], onDelete: Cascade)
  recipient       User            @relation(fields: [recipientId], references: [id])

  @@unique([escalationEventId, recipientId]) // no double-notify
  @@index([recipientId, readAt, createdAt(sort: Desc)])
}

model JobRun {
  id         String    @id @default(cuid())
  jobName    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  outcome    String? // COMPLETED | SKIPPED_LOCKED | FAILED
  scanned    Int       @default(0)
  escalated  Int       @default(0)
  notified   Int       @default(0)
  error      String?

  @@index([jobName, startedAt(sort: Desc)])
}

// NEW model (build-plan.md B3): the escalation job's run-level guard. The advisory
// lock only serialises the sub-millisecond CLAIM of this row; the lease itself is what
// survives across the batched scan, which now runs as many short transactions instead
// of one long one. See docs/escalation.md for the full rationale.
model JobLease {
  jobName    String    @id
  ownerRunId String?
  heldUntil  DateTime?
  updatedAt  DateTime  @updatedAt
}
