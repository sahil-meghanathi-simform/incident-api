NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://incident:incident@postgres:5432/incident_db?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7

CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=incident-images

ESCALATION_TICK_MS=60000
ESCALATION_LEASE_MS=300000
ESCALATION_BATCH_SIZE=500

ESCALATION_HIGH_L1_MINUTES=30
ESCALATION_HIGH_L2_MINUTES=90
ESCALATION_HIGH_L3_MINUTES=240
ESCALATION_CRITICAL_L1_MINUTES=15
ESCALATION_CRITICAL_L2_MINUTES=60
ESCALATION_CRITICAL_L3_MINUTES=240

LOG_LEVEL=info
SEED_INCIDENT_COUNT=5000
SEED_RANDOM_SEED=incident-poc-2026
